
@model DangTheToan_241230865.Models.Sach
<div class="section-head">
	<h3>ĐẶNG THẾ TOÀN - THÊM SÁCH</h3>
</div>

<div style="background:#fff;padding:20px;border-radius:6px;max-width:420px;box-shadow:0 1px 4px rgba(0,0,0,0.08);">
	<form asp-action="Create" method="post">
		<div asp-validation-summary="ModelOnly" style="color:red ;margin-bottom:10px;"></div>

		<div style="margin-bottom:12px;">
			<label asp-for="MaTl" style="display:block;margin-bottom:4px;font-weight:600;">MaTL</label>
			<select asp-for="MaTl" asp-items="ViewBag.MaTL" style="width:240px;padding:6px"></select>
			<span asp-validation-for="MaTl" style="color:red; font-size:13px;display:block;"></span>
		</div>

		<div style="margin-bottom:12px;">
			<label asp-for="TenSach" style="display:block;margin-bottom:4px;font-weight:600;">TenSach</label>
			<select asp-for="TenSach" style="width:240px;padding:6px"></select>
			<span asp-validation-for="TenSach" style="color:red; font-size:13px;display:block;"></span>
		</div>

		<div style="margin-bottom:12px;">
			<label asp-for="Gia" style="display:block;margin-bottom:4px;font-weight:600;">Gia</label>
			<select asp-for="Gia" style="width:240px;padding:6px"></select>
			<span asp-validation-for="Gia" style="color:red; font-size:13px;display:block;"></span>
		</div>

		<div style="margin-bottom:15px;">
			<label asp-for="Anh" style="display:block;margin-bottom:4px;font-weight:600;">Anh</label>
			<select asp-for="Anh" placeholder="Ví dụ: Img_1.jpg" style="width:240px;padding:6px"></select>
			<span asp-validation-for="Anh" style="color:red; font-size:13px;display:block;"></span>
		</div>

		<button type="submit" class="btn-buy" style="padding:8px 18px;">Create</button>
	</form>
</div>

@section Scripts{
	<partial name="_ValidationScriptsPartial" />
}