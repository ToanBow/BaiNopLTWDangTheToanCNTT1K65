@model IEnumerable<DangTheToan_241230865.Models.Sach>

<div class="section-head">
	<h3>@ViewBag.SectionTitle</h3>
	<a asp-controller="Home" asp-action="Create">Thêm sách mới</a>
</div>

<div class="grid">
	@foreach(var item in Model)
	{
		<div class="book-card">
			<a href="#"><img src="~/images/@item.Anh" alt="@item.TenSach"/></a>
			<h2>@item.TenSach</h2>
			<div class="book-foot">
				<span class="price">@item.Gia</span>
				<button type="button" class="btn-buy">Thêm vào giỏ</button>
			</div>
		</div>
	}
</div>