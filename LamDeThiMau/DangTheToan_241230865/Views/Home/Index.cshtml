@model IEnumerable<DangTheToan_241230865.Models.HangHoa>
<div class="content_top">
	<div class="heading">
		<h3>Đặng Thế Toàn</h3>
	</div>
	<div class="see">
		<p><a asp-controller="Home" asp-action="Create">Thêm hàng hoá mới</a></p>
	</div>
	<div class="clear"></div>
</div>

<div id="main-product-list">
	<partial name="_HangHoaList" model="Model" />
</div>

@section Scripts{
	<script>
		$(document).ready(function(){
			$(".loai-hang-link").click(function (e) {
				e.preventDefault();

				$(".menu ul li").removeClass("active");
				$(this).parent("li").addClass("active");

				var maLoai = $(this).data("id");

				$.ajax({
					url:'@Url.Action("GetHangHoaByLoai","Home")',
					type:'GET',
					data: {maLoai:maLoai},
					success: function (response) {
						$("#main-product-list").html(response);
					},
					error:function(){
						alert("Khong the tai du lieu hang hoa");
					}
				})
			})
		})
	</script>
}