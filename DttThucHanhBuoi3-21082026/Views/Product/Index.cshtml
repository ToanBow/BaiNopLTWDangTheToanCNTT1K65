@model DttThucHanhBuoi3_21082026.Models.ProductCatalogViewModel
@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<style>
    .category-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #333;
    }

    .category-list .list-group-item {
        font-size: 0.9rem;
        color: #555;
        padding: 9px 15px;
    }

        .category-list .list-group-item.active {
            background-color: #f0f0f0;
            border-color: #ddd;
            color: #000;
            font-weight: bold;
        }

    .product-card {
        border: 1px solid #e2e8f0;
    }

    .product-img-box {
        height: 230px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 10px;
    }

        .product-img-box img {
            max-height: 100%;
            max-width: 100%;
            object-fit: contain;
        }

    .product-title {
        font-size: 0.95rem;
        min-height: 42px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .btn-detail {
        background-color: #5cb85c;
        color: #fff;
        border: none;
        font-size: 0.85rem;
    }

        .btn-detail:hover {
            background-color: #4cae4c;
            color: #fff;
        }
</style>

<div class="container-fluid mt-3">
    <div class="row">
        <!-- Sidebar Danh mục (Bên trái) -->
        <aside class="col-12 col-md-3 col-lg-2 mb-4">
            <h5 class="category-title mb-3">DANH MỤC</h5>
            <div class="list-group category-list rounded-0 shadow-sm">
                <a asp-action="Index"
                   asp-route-categoryId=""
                   class="list-group-item list-group-item-action @(!Model.SelectedCategoryId.HasValue ? "active" : "")">
                    Tất cả sản phẩm
                </a>
                @foreach (var cat in Model.Categories)
                {
                    <a asp-action="Index"
                       asp-route-categoryId="@cat.Id"
                       class="list-group-item list-group-item-action @(Model.SelectedCategoryId == cat.Id ? "active" : "")">
                        @cat.Name
                    </a>
                }
            </div>
        </aside>

        <!-- Lưới sản phẩm -->
        <main class="col-12 col-md-9 col-lg-10">
            <h4 class="fw-normal mb-3">Danh sách sản phẩm</h4>

            <div class="row g-3">
                @if (Model.Products.Any())
                {
                    @foreach (var item in Model.Products)
                    {
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="card h-100 product-card rounded-0">
                                <div class="product-img-box">
                                    <img src="@item.ImageUrl" asp-append-version="true" alt="@item.Name" loading="lazy" />
                                </div>
                                <div class="card-body d-flex flex-column justify-content-between p-3">
                                    <h6 class="product-title mb-2">@item.Name</h6>
                                    <div class="small mb-3">
                                        <span>Giá: <del class="text-muted">@item.OriginalPrice.ToString("N0")</del></span>
                                        <span class="ms-1">Giá: <strong>@item.SalePrice.ToString("N0")</strong></span>
                                    </div>
                                    <!-- Nút chuyển sang trang Chi tiết -->
                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-detail w-100 py-1">
                                        Chi tiết
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center text-muted py-5">
                        Không có sản phẩm nào thuộc danh mục này.
                    </div>
                }
            </div>
        </main>
    </div>
</div>