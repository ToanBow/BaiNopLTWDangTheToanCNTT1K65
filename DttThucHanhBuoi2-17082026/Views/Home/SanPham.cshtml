@model IEnumerable<DttThucHanhBuoi2_17082026.Models.Product>
@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<h3 class="mb-4 fw-normal">Quản lý sản phẩm</h3>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr class="fw-bold border-bottom">
                <th scope="col" style="width: 8%;">ID</th>
                <th scope="col" style="width: 25%;">Name</th>
                <th scope="col" style="width: 20%;">Price</th>
                <th scope="col" style="width: 20%;">Created At</th>
                <th scope="col" style="width: 15%;">Image</th>
                <th scope="col" style="width: 12%;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="border-bottom">
                    <td class="fw-bold">@item.Id</td>
                    <td>@item.Name</td>
                    <td>@($"{item.Price:N0} đ")</td>
                    <td>@item.CreatedAt.ToString("dd-MM-yyyy")</td>
                    <td>
                        <img src="@item.ImageUrl"
                             asp-append-version="true"
                             alt="@item.Name"
                             width="60" height="60"
                             class="img-fluid"
                             style="object-fit: contain;" />
                    </td>
                    <td>
                        <a href="#" class="btn btn-success btn-sm px-3" style="background-color: #4CAF50; border: none;">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>